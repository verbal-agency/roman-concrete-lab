{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roman-concrete-lab.local/schemas/prelab-result.schema.json",
  "title": "GP2 pre-lab result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id",
    "context_id",
    "context_version",
    "candidate_id",
    "hypothesis_id",
    "condition_id",
    "batch_id",
    "specimen_id",
    "measurement",
    "comparator_status",
    "provenance_complete",
    "safety_status",
    "outcome_class",
    "result_status"
  ],
  "properties": {
    "result_id": {"type": "string", "minLength": 1},
    "context_id": {"const": "roman-concrete-v1"},
    "context_version": {"const": "1.0"},
    "candidate_id": {"enum": ["RC-01", "RC-02", "RC-03", "RC-04", "RC-05"]},
    "hypothesis_id": {"type": "string", "pattern": "^H-RC[0-9]{2}-[0-9]{2}$"},
    "condition_id": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "specimen_id": {"type": "string", "minLength": 1},
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "value", "unit", "uncertainty", "missingness", "censoring", "source_locator"],
      "properties": {
        "endpoint": {"enum": ["functional_water_flow_recovery", "permeability_recovery", "crack_closure", "compressive_strength_retention", "microcrack_occlusion"]},
        "value": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"]},
        "uncertainty": {"type": ["string", "number", "null"]},
        "missingness": {"enum": ["observed", "not_reported", "censored", "unresolved"]},
        "censoring": {"enum": ["none", "left", "right", "interval", "unresolved"]},
        "source_locator": {"type": "string", "minLength": 1}
      }
    },
    "comparator_status": {"enum": ["matched", "unmatched", "unclear", "not_applicable"]},
    "provenance_complete": {"type": "boolean"},
    "safety_status": {"enum": ["reviewed", "unreviewed", "unsafe", "not_assessed"]},
    "outcome_class": {"enum": ["positive", "null", "contradictory", "incomplete", "unsafe", "unsupported"]},
    "result_status": {"enum": ["SUPPORTED", "NARROW_USE_CASE", "INCONCLUSIVE", "NOT_REPRODUCED", "REVIEW_REQUIRED"]}
  }
}
