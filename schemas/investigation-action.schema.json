{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roman-concrete-lab.local/schemas/investigation-action.schema.json",
  "title": "InvestigationAction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_id",
    "run_id",
    "case_id",
    "problem_id",
    "problem_version",
    "arm",
    "branch_id",
    "action_type",
    "rationale",
    "input",
    "policy_status",
    "budget_debit",
    "output_ids",
    "replay_key",
    "timestamp"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "action_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "problem_id": {"type": "string", "minLength": 1},
    "problem_version": {"type": "string", "minLength": 1},
    "arm": {"enum": ["A0", "A1", "A2", "A2-M"]},
    "branch_id": {"type": "string", "minLength": 1},
    "action_type": {"enum": ["SEARCH", "FETCH_PERMITTED_CONTENT", "INSPECT_EXISTING_EVIDENCE", "RUN_DECLARED_SIMULATION", "ABSTAIN"]},
    "rationale": {"type": "string"},
    "input": {"type": "object"},
    "policy_status": {"enum": ["ALLOWED", "REPLAYED", "RIGHTS_BLOCKED", "POLICY_BLOCKED", "BUDGET_EXHAUSTED", "SIMULATOR_UNAVAILABLE", "ABSTAIN"]},
    "budget_debit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queries", "retained_sources", "document_fetches", "payload_bytes", "simulation_calls", "input_tokens", "output_tokens", "estimated_cost_usd"],
      "properties": {
        "queries": {"type": "integer", "minimum": 0},
        "retained_sources": {"type": "integer", "minimum": 0},
        "document_fetches": {"type": "integer", "minimum": 0},
        "payload_bytes": {"type": "integer", "minimum": 0},
        "simulation_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "estimated_cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "output_ids": {"type": "array", "items": {"type": "string"}},
    "replay_key": {"type": "string", "pattern": "^sha256:"},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
