{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roman-concrete-lab.local/schemas/open-viewpoint-admission.schema.json",
  "title": "OpenViewpointAdmission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "admission_id", "case_id", "viewpoint_id", "novelty_basis", "source_candidate_ids", "claim_ids", "predicted_observation", "falsifier", "discriminator", "overlap_decision", "status", "promotion_status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "admission_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "viewpoint_id": {"type": "string", "minLength": 1},
    "novelty_basis": {"type": "string", "minLength": 1},
    "source_candidate_ids": {"type": "array", "items": {"type": "string"}},
    "claim_ids": {"type": "array", "items": {"type": "string"}},
    "predicted_observation": {"type": "string", "minLength": 1},
    "falsifier": {"type": "string", "minLength": 1},
    "discriminator": {"type": "string", "minLength": 1},
    "overlap_decision": {"enum": ["DISTINCT", "REDUNDANT", "NO_COMPARABLE_INCUMBENT"]},
    "status": {"enum": ["ADMITTED", "REJECTED_REDUNDANT", "ABSTAINED_NO_DISTINCT_VIEWPOINT"]},
    "promotion_status": {"const": "REVIEW_REQUIRED"}
  }
}
