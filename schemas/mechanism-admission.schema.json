{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roman-concrete-lab.local/schemas/mechanism-admission.schema.json",
  "title": "Open mechanism admission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "admission_id", "case_id", "mechanism_card", "reason", "evidence_locator", "uncertainty_basis", "budget_debit", "status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "admission_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "mechanism_card": {"$ref": "mechanism-card.schema.json"},
    "reason": {"type": "string", "minLength": 1},
    "evidence_locator": {"type": "string", "minLength": 1},
    "uncertainty_basis": {"type": "string", "minLength": 1},
    "budget_debit": {"type": "integer", "minimum": 0},
    "status": {"enum": ["ADMITTED", "REJECTED"]}
  }
}
