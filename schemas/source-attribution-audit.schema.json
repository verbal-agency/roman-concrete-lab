{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roman-concrete-lab.local/schemas/source-attribution-audit.schema.json",
  "title": "Source attribution audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_candidate_id", "status", "proof"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_candidate_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["UNREVIEWED", "ATTRIBUTED", "CONTRADICTS_INCUMBENT", "PROVENANCE_UNVERIFIED", "FABRICATION_CONFIRMED"]},
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "evidence_locators", "claimed_identity", "observed_identity"],
      "properties": {
        "method": {"enum": ["LOCATOR_RESOLVES_TO_DIFFERENT_WORK", "HASH_CONFLICT_WITH_CLAIMED_SOURCE", "AUTHOR_OR_TITLE_CONFLICT", "SOURCE_OWNER_DENIES_RECORD", "CROSS_SOURCE_MISREPRESENTATION"]},
        "evidence_locators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "claimed_identity": {"type": "string", "minLength": 1},
        "observed_identity": {"type": "string", "minLength": 1}
      }
    }
  }
}
