{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "g10b-output.schema.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "task_type", "status", "summary", "findings", "recommended_action", "authority_note"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "task_type": {"enum": ["contradiction_triage", "rival_hypotheses", "discriminating_experiment", "provenance_audit"]},
    "status": {"enum": ["ANSWER", "ABSTAIN", "REVIEW_REQUIRED"]},
    "summary": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "kind", "statement", "evidence_ids", "predicted_observation", "disconfirming_observation", "uncertainty"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["SUPPORTED_ASSERTION", "HYPOTHESIS", "CONTRADICTION", "DISCRIMINATOR", "LIMITATION"]},
          "statement": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "predicted_observation": {"type": "string"},
          "disconfirming_observation": {"type": "string"},
          "uncertainty": {"type": "string", "minLength": 1}
        }
      }
    },
    "recommended_action": {"type": "string", "minLength": 1},
    "authority_note": {"type": "string", "minLength": 1}
  }
}
