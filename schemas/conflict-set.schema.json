{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roman-concrete-lab.local/schemas/conflict-set.schema.json",
  "title": "ConflictSet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "conflict_set_id", "case_id", "problem_id", "problem_version", "claim_id", "edge_ids", "independent_source_ids", "scope", "status", "revision_number"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "conflict_set_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "problem_id": {"type": "string", "minLength": 1},
    "problem_version": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "edge_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "independent_source_ids": {"type": "array", "items": {"type": "string"}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["material", "process", "comparator", "endpoint", "method"], "properties": {"material": {"type": "string"}, "process": {"type": "string"}, "comparator": {"type": "string"}, "endpoint": {"type": "string"}, "method": {"type": "string"}}},
    "status": {"enum": ["OPEN", "SCOPE_DIFFERENCE", "METHOD_DIFFERENCE", "WEIGHTED_CONFLICT", "UNRESOLVED"]},
    "revision_number": {"type": "integer", "minimum": 0}
  }
}
