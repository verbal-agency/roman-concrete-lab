{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roman-concrete-lab.local/schemas/viewpoint-support-report.schema.json",
  "title": "Viewpoint support report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "case_id", "viewpoint_id", "support_task_id", "stance", "action_ids", "source_candidate_ids", "claim_ids", "summary", "unresolved_questions", "status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "viewpoint_id": {"type": "string", "minLength": 1},
    "support_task_id": {"type": "string", "minLength": 1},
    "stance": {"enum": ["SUPPORTS", "WEAKENS", "NON_DISCRIMINATING"]},
    "action_ids": {"type": "array", "items": {"type": "string"}},
    "source_candidate_ids": {"type": "array", "items": {"type": "string"}},
    "claim_ids": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string", "minLength": 1},
    "unresolved_questions": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["COMPLETE", "PARTIAL", "ABSTAINED", "FAILED"]}
  }
}
