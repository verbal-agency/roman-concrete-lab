{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roman-concrete-lab.local/schemas/g10r-ab-repair-config.schema.json",
  "type": "object",
  "required": ["schema_version", "goal", "manifest_id", "flags", "source_policy_mode", "budget_cap_usd", "mutable_during_run"],
  "properties": {
    "schema_version": {"const": "g10r-ab.1"},
    "goal": {"const": "G10R-AB"},
    "manifest_id": {"type": "string", "minLength": 1},
    "source_manifest_id": {"type": "string", "minLength": 1},
    "flags": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "source_policy_mode": {"const": "frozen_exact_host_read_only"},
    "budget_cap_usd": {"const": 25.0},
    "mutable_during_run": {"const": false}
  },
  "additionalProperties": false
}
