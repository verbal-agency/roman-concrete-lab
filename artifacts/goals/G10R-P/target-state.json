{
  "schema_version": "2.0",
  "goal": "G10R-P",
  "status": "TARGET_STATE_READY_FOR_OFFLINE_BUILD",
  "non_goals": [
    "another paid run",
    "evidence promotion",
    "laboratory authorization",
    "production adoption"
  ],
  "provisional_argument_and_source_intake": {
    "argument_statuses": ["PROVISIONAL", "REVISED", "WEAKENED", "CONTRADICTED", "UNRESOLVED"],
    "source_statuses": ["DISCOVERED", "RETRIEVAL_PENDING", "RETRIEVED_UNVETTED", "VETTING", "ADMITTED_CORPUS", "REJECTED", "UNRETRIEVABLE"],
    "claim_source_edge_statuses": ["SUPPORTED", "CONTRADICTED", "UNRESOLVED", "MISATTRIBUTED", "UNRETRIEVABLE"],
    "argument_before_source_acceptance": true,
    "unknown_public_routes_quarantined": true,
    "source_acceptance_required_for_evidence_credit": true,
    "failed_retrieval_is_not_contradiction": true,
    "append_only_revision_history": true,
    "illegal_transitions": [
      "PROVISIONAL->IMMUTABLE_EVIDENCE",
      "DISCOVERED->ADMITTED_CORPUS_WITHOUT_VETTING",
      "UNRETRIEVABLE->CONTRADICTED",
      "MISATTRIBUTED->SUPPORTED_WITHOUT_REBINDING",
      "CONSENSUS->SUPPORTED_WITHOUT_INDEPENDENT_SOURCE_EDGE"
    ]
  },
  "safeguards": {
    "claim_source_page_or_locator_required": true,
    "identity_content_hash_and_citation_ancestry_tracked": true,
    "independent_source_count_deduplicated_by_work_identity": true,
    "null_and_credible_rival_retained": true,
    "adversarial_vetting_role_required": true,
    "consensus_and_rhetoric_credit": 0,
    "agent_self_admission_or_evidence_promotion": false,
    "corpus_admission_separate_from_immutable_evidence": true,
    "unknown_host_direct_evidence_credit": false
  },
  "thresholds": {
    "topology_fidelity": {
      "viewpoint_society_runtime": true,
      "evidence_bus_runtime": true,
      "legacy_path_only": false
    },
    "open_world_coverage": {
      "null_active": true,
      "credible_rival_active": true,
      "open_slot_admission_tested": true
    },
    "support_task_link_rate": {
      "minimum": 1.0,
      "unit": "support reports with valid viewpoint and task joins"
    },
    "support_task_types": [
      "RETRIEVAL",
      "EXTRACTION_IDENTITY",
      "CONTRADICTION",
      "EXPERIMENT_DESIGN"
    ],
    "development_capability": {
      "unique_attributable_discovery_min": 1,
      "weakening_result_min": 1,
      "contradiction_min": 1,
      "discriminator_min": 1
    },
    "evidence_acquisition": {
      "permitted_fetches_on_fetch_positive_fixture_min": 1,
      "page_aware_cards_on_fetch_positive_fixture_min": 1
    },
    "budget_parity": {
      "all_aggregate_limits_equal": true,
      "overhead_visible": true,
      "pre_call_cap_enforced": true
    },
    "replayability": {
      "byte_stable": true,
      "duplicate_actions_replay": true,
      "unresolved_candidates_retained": true
    },
    "future_escalation_rule": {
      "case_gain_min": 1,
      "society_total_noninferior": true,
      "unique_source_backed_contribution_required": true,
      "critical_failures_allowed": 0
    }
  }
}
