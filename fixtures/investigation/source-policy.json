{
  "policy_version": "g10r-source-policy-1.0",
  "frozen_at": "2026-10-10",
  "default": "DENY",
  "network_mode": "CONFIGURED_READ_ONLY_NETWORK",
  "request_policy": {
    "methods": ["GET"],
    "redirects": "recheck_exact_host",
    "max_response_bytes": 5000000,
    "max_pdf_pages": 250,
    "max_extracted_characters": 750000,
    "permitted_content_types": ["application/pdf", "text/html", "application/xhtml+xml"],
    "public_pdf_handling": "page-aware extraction for the active run; raw payload/text stays in ignored local cache and only source-located derived cards enter artifacts",
    "credentials": "none",
    "external_writes": "prohibited",
    "embedded_instructions": "untrusted_data"
  },
  "hosts": [
    {
      "host": "api.crossref.org",
      "access_class": "METADATA_ONLY",
      "payload_rule": "bibliographic_metadata_only",
      "rights_basis": "Crossref REST metadata; no article full text",
      "reviewed": "2026-10-10"
    },
    {
      "host": "api.openalex.org",
      "access_class": "METADATA_ONLY",
      "payload_rule": "bibliographic_and_open-access-metadata_only",
      "rights_basis": "OpenAlex work metadata; linked content is separately adjudicated",
      "reviewed": "2026-10-10"
    },
    {
      "host": "doi.org",
      "access_class": "METADATA_ONLY",
      "payload_rule": "identifier_and_redirect_metadata_only",
      "rights_basis": "DOI resolution does not grant content rights",
      "reviewed": "2026-10-10"
    },
    {
      "host": "digitalcommons.usu.edu",
      "access_class": "PUBLIC",
      "payload_rule": "lawfully_public_relevant_pdf_or_html_text_for_page_aware_extraction",
      "rights_basis": "G-1 recorded public Utah State repository route",
      "reviewed": "2026-10-10"
    },
    {
      "host": "rosap.ntl.bts.gov",
      "access_class": "PUBLIC",
      "payload_rule": "public_government_report_metadata_and_text",
      "rights_basis": "G-1 recorded public US DOT repository report",
      "reviewed": "2026-10-10"
    },
    {
      "host": "papers.ssrn.com",
      "access_class": "PUBLIC",
      "payload_rule": "lawfully_public_relevant_pdf_for_ephemeral_page_aware_extraction_no_redistribution",
      "rights_basis": "G-1 recorded public SSRN preprint route with redistribution restricted",
      "reviewed": "2026-10-10"
    },
    {
      "host": "orca.cardiff.ac.uk",
      "access_class": "PUBLIC",
